# DashScope / OpenAI-compatible LLM configuration
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_MODEL=qwen3.7-plus
AGENT_STREAM_ENABLED=true

# Sky Take-Out Java backend (admin/customer JWTs are passed per-request via headers, never hardcoded here)
SKY_BACKEND_BASE_URL=http://localhost:8080
BACKEND_HTTP_MAX_CONNECTIONS=50
BACKEND_HTTP_MAX_KEEPALIVE=20
BACKEND_HTTP_TIMEOUT_SECONDS=10.0

# Session & Multi-Turn Sliding-Window Compaction
STATE_STORE_MODE=memory
REDIS_URL=redis://localhost:6379/1
REDIS_KEY_PREFIX=sky_agent
AGENT_SESSION_IDLE_SECONDS=1800
AGENT_SESSION_MAX_ENTRIES=500
CONTEXT_MAX_MESSAGES=12
CONTEXT_KEEP_RECENT_MESSAGES=6
CONTEXT_MAX_CHARS=12000
CONTEXT_SUMMARY_MAX_CHARS=1600

# Merchant Async Report Reviewer (off | mock | llm)
REPORT_REVIEW_MODE=off
REPORT_REVIEW_MODEL=qwen3.7-plus
REPORT_REVIEW_MAX_TOKENS=1536
REPORT_REVIEW_HTTP_TIMEOUT_SECONDS=22.0
REPORT_REVIEW_TIMEOUT_SECONDS=26.0

# Human-in-the-Loop Dish Status Approval
APPROVAL_MAX_ENTRIES=200
APPROVAL_TTL_SECONDS=300.0

# Per-Actor Rate Limiting & Daily Token FinOps Budget
CHAT_RATE_LIMIT_PER_MINUTE=20
DAILY_TOKEN_BUDGET_PER_USER=200000
